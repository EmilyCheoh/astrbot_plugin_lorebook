{
    "lorebooks": {
        "description": "世界书",
        "type": "template_list",
        "hint": "每本世界书包含独立的注入设置和最多 20 个条目。点击右侧「添加」创建新的世界书。",
        "templates": {
            "lorebook": {
                "name": "新世界书",
                "items": {
                    "lorebook_info": {
                        "description": "基本设置",
                        "type": "object",
                        "items": {
                            "book_name": {
                                "description": "世界书名称",
                                "type": "string",
                                "default": ""
                            },
                            "enabled": {
                                "description": "启用世界书",
                                "hint": "关闭后整本世界书不进行匹配和注入。",
                                "type": "bool",
                                "default": true
                            },
                            "injection_position": {
                                "description": "注入位置",
                                "type": "string",
                                "default": "user_message_after",
                                "options": [
                                    "user_message_before",
                                    "user_message_after",
                                    "system_prompt"
                                ]
                            },
                            "tag_name": {
                                "description": "XML 标签名称",
                                "hint": "用于包裹注入内容的 XML 标签名称。不需要包含尖括号。仅允许字母、数字、连字符、下划线。",
                                "type": "string",
                                "default": "Additional-Info"
                            },
                            "header_text": {
                                "description": "标签头部说明文本",
                                "hint": "注入内容开头的说明文字，留空则不添加。",
                                "type": "string",
                                "default": ""
                            }
                        }
                    },
                    "entry_1": {
                        "description": "条目 1",
                        "hint": "第 1 个世界书条目。名称留空则跳过。",
                        "type": "object",
                        "items": {
                            "name": {
                                "description": "名称",
                                "hint": "条目的唯一标识。",
                                "type": "string",
                                "default": ""
                            },
                            "enabled": {
                                "description": "启用",
                                "hint": "关闭后该条目不参与匹配。",
                                "type": "bool",
                                "default": true
                            },
                            "priority": {
                                "description": "优先级",
                                "hint": "多个条目同时命中时的注入顺序，1 = 最高优先，10 = 最低。",
                                "type": "int",
                                "slider": {
                                    "min": 1,
                                    "max": 10,
                                    "step": 1
                                },
                                "default": 5
                            },
                            "keywords": {
                                "description": "正则触发",
                                "hint": "当用户消息匹配时触发。支持正则语法。任一匹配即触发。",
                                "type": "list",
                                "default": []
                            },
                            "content": {
                                "description": "注入内容",
                                "hint": "条目触发时注入到 LLM 请求中的内容。",
                                "type": "text",
                                "default": ""
                            }
                        }
                    },
