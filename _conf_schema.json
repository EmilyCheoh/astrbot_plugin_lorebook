{
    "lorebooks": {
        "description": "世界书",
        "type": "template_list",
        "hint": "每本世界书包含独立的注入设置和最多 20 个条目。点击右侧「添加」创建新的世界书。",
        "templates": {
            "lorebook": {
                "name": "新世界书",
                "items": {
                    "book_name": {
                        "description": "世界书名称",
                        "hint": "方便识别这本世界书的用途。",
                        "type": "string",
                        "default": ""
                    },
                    "enabled": {
                        "description": "启用世界书",
                        "hint": "关闭后整本世界书不进行匹配和注入。",
                        "type": "bool",
                        "default": true
                    },
                    "injection_position": {
                        "description": "注入位置",
                        "hint": "匹配到的条目注入到 LLM 请求的位置。user_message_before: 用户消息前；user_message_after: 用户消息后；system_prompt: 追加到系统提示词。",
                        "type": "string",
                        "default": "user_message_after",
                        "options": [
                            "user_message_before",
                            "user_message_after",
                            "system_prompt"
                        ]
                    },
                    "tag_name": {
                        "description": "XML 标签名称",
                        "hint": "用于包裹注入内容的 XML 标签名称。不需要包含尖括号。仅允许字母、数字、连字符、下划线。",
                        "type": "string",
                        "default": "Additional-Info"
                    },
                    "header_text": {
                        "description": "标签头部说明文本",
                        "hint": "注入内容开头的说明文字，紧跟在 XML 开标签之后、条目内容之前。留空则不添加。",
                        "type": "string",
                        "default": ""
                    },
                    "entry_1_name": {
                        "description": "条目 1 — 名称",
                        "hint": "条目的唯一标识，用于日志。留空则跳过该条目。",
                        "type": "string",
                        "default": ""
                    },
                    "entry_1_enabled": {
                        "description": "条目 1 — 启用",
                        "hint": "关闭后该条目不参与匹配。",
                        "type": "bool",
                        "default": true
                    },
                    "entry_1_priority": {
                        "description": "条目 1 — 优先级",
                        "hint": "多个条目同时命中时的注入顺序，1 = 最高优先，10 = 最低。",
                        "type": "int",
                        "slider": {
                            "min": 1,
                            "max": 10,
                            "step": 1
                        },
                        "default": 5
                    },
                    "entry_1_keywords": {
                        "description": "条目 1 — 正则触发",
                        "hint": "当用户消息匹配时触发。支持正则语法。任一匹配即触发。",
                        "type": "list",
                        "default": []
                    },
                    "entry_1_content": {
                        "description": "条目 1 — 注入内容",
                        "hint": "条目触发时注入到 LLM 请求中的内容。",
                        "type": "text",
